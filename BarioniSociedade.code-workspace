{
  "folders": [{ "name": "BarioniSociedade", "path": "." }],
  "settings": {
    "files.encoding": "utf8",
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      ".venv": true,
      ".agents": true
    },
    "search.exclude": {
      "**/.venv": true,
      "**/__pycache__": true,
      "dist": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "BarioniSociedade: iniciar site",
        "type": "process",
        "command": "python",
        "args": ["scripts/development/start_server.py"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": []
      },
      {
        "label": "BarioniSociedade: verificar referências",
        "type": "process",
        "command": "python",
        "args": ["scripts/development/check_html_refs.py"],
        "options": { "cwd": "${workspaceFolder}" },
        "problemMatcher": []
      },
      {
        "label": "BarioniSociedade: gerar publicação",
        "type": "process",
        "command": "python",
        "args": ["scripts/deployment/package_site.py"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": []
      }
    ]
  }
}
